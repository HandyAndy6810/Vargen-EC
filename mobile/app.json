{
  "expo": {
    "name": "Vargen EZ",
    "slug": "vgnec",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "vargen",
    "userInterfaceStyle": "automatic",
    "newArchEnabled": false,
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "com.vargen.ec",
      "backgroundColor": "#F2F2F0",
      "buildNumber": "1",
      "infoPlist": {
        "NSCameraUsageDescription": "Used to capture photos for jobs and invoices.",
        "NSPhotoLibraryUsageDescription": "Used to attach photos to jobs and invoices.",
        "NSMicrophoneUsageDescription": "Used for AI voice-to-quote dictation.",
        "NSLocationWhenInUseUsageDescription": "Used to show weather conditions for your location.",
        "NSLocationAlwaysAndWhenInUseUsageDescription": "Used to show weather conditions for your location.",
        "ITSAppUsesNonExemptEncryption": false
      },
      "icon": {
        "light": "./assets/images/icon.png",
        "dark": "./assets/images/icon-dark.png",
        "tinted": "./assets/images/icon-tinted.png"
      }
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/images/adaptive-icon.png",
        "monochromeImage": "./assets/images/adaptive-icon-monochrome.png",
        "backgroundColor": "#FFFFFF"
      },
      "package": "com.vargen.ec",
      "versionCode": 1,
      "permissions": [
        "android.permission.CAMERA",
        "android.permission.READ_EXTERNAL_STORAGE",
        "android.permission.WRITE_EXTERNAL_STORAGE",
        "android.permission.RECORD_AUDIO",
        "android.permission.RECEIVE_BOOT_COMPLETED",
        "android.permission.VIBRATE",
        "android.permission.ACCESS_FINE_LOCATION",
        "android.permission.ACCESS_COARSE_LOCATION",
        "android.permission.FOREGROUND_SERVICE"
      ]
    },
    "web": {
      "bundler": "metro",
      "output": "static",
      "favicon": "./assets/images/favicon.png",
      "backgroundColor": "#F2F2F0"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "image": "./assets/images/splash-icon.png",
          "imageWidth": 200,
          "resizeMode": "contain",
          "backgroundColor": "#FFFFFF",
          "dark": {
            "image": "./assets/images/splash-icon.png",
            "backgroundColor": "#141416"
          }
        }
      ],
      "expo-secure-store",
      [
        "expo-build-properties",
        {
          "ios": {
            "deploymentTarget": "15.1",
            "ccFlags": "-DFOLLY_CFG_NO_COROUTINES=1"
          }
        }
      ],
      [
        "expo-font",
        {
          "fonts": [
            "./node_modules/@expo-google-fonts/host-grotesk/300Light/HostGrotesk_300Light.ttf",
            "./node_modules/@expo-google-fonts/host-grotesk/400Regular/HostGrotesk_400Regular.ttf",
            "./node_modules/@expo-google-fonts/host-grotesk/500Medium/HostGrotesk_500Medium.ttf",
            "./node_modules/@expo-google-fonts/host-grotesk/600SemiBold/HostGrotesk_600SemiBold.ttf",
            "./node_modules/@expo-google-fonts/host-grotesk/700Bold/HostGrotesk_700Bold.ttf",
            "./node_modules/@expo-google-fonts/host-grotesk/800ExtraBold/HostGrotesk_800ExtraBold.ttf"
          ]
        }
      ],
      [
        "expo-notifications",
        {
          "icon": "./assets/images/notification-icon.png",
          "color": "#FF5C00",
          "sounds": []
        }
      ],
      "expo-updates",
      "expo-image-picker",
      "expo-location",
      "./plugins/with-folly-fix"
    ],
    "experiments": {
      "typedRoutes": true
    },
    "updates": {
      "fallbackToCacheTimeout": 0,
      "url": "https://u.expo.dev/481ac436-4f04-451b-8cf6-48aaaf94e24b"
    },
    "runtimeVersion": {
      "policy": "appVersion"
    },
    "extra": {
      "eas": {
        "projectId": "481ac436-4f04-451b-8cf6-48aaaf94e24b"
      }
    },
    "owner": "handyandy6810"
  }
}
